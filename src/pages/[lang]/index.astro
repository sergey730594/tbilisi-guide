---
import { languages, ui, defaultLang } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'ka' } },
    { params: { lang: 'en' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'tr' } },
    { params: { lang: 'ar' } },
  ];
}

const { lang } = Astro.params;
const currentLang = (lang && lang in ui) ? lang as keyof typeof ui : defaultLang;
const t = (key: keyof typeof ui[typeof defaultLang]) => ui[currentLang][key] || ui[defaultLang][key];

// Для Арабского языка включаем чтение справа налево (RTL)
const dir = currentLang === 'ar' ? 'rtl' : 'ltr';

const spots = [
  {
    title: t('cards.nomad.title'),
    category: "Work & Vibe",
    description: t('cards.nomad.desc'),
    tag: "Digital Nomad",
    color: "bg-amber-100 text-amber-800"
  },
  {
    title: t('cards.wine.title'),
    category: "Gastronomy",
    description: t('cards.wine.desc'),
    tag: "True Local",
    color: "bg-rose-100 text-rose-800"
  },
  {
    title: t('cards.logistics.title'),
    category: "Smart Travel",
    description: t('cards.logistics.desc'),
    tag: "Must Read",
    color: "bg-emerald-100 text-emerald-800"
  }
];
---

<html lang={currentLang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TBILISI GUIDE</title>
  </head>
  <body class="bg-[#FDFBF7] text-slate-800 font-sans antialiased">
    
    <!-- Header -->
    <header class="border-b border-stone-200 bg-white/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
        <!-- Кликабельный логотип (Home) -->
        <a href={`/${currentLang}/`} class="font-extrabold text-xl tracking-tight text-[#8B263E] hover:opacity-80 transition">
          TBILISI GUIDE
        </a>
        
        <div class="flex items-center space-x-6">
          <nav class="hidden sm:flex space-x-6 text-sm font-medium text-stone-600">
            <a href="#spots" class="hover:text-stone-900 transition">{t('nav.spots')}</a>
            <a href="#logistics" class="hover:text-stone-900 transition">{t('nav.logistics')}</a>
            <a href="#nomad" class="hover:text-stone-900 transition">{t('nav.nomad')}</a>
          </nav>

          <!-- Переключатель языков -->
          <div class="flex space-x-1.5 bg-stone-100 p-1 rounded-lg text-xs font-semibold">
            {Object.entries(languages).map(([key, label]) => (
              <a
                href={`/${key}/`}
                class={`px-2 py-1 rounded-md transition ${
                  currentLang === key
                    ? 'bg-white text-[#8B263E] shadow-sm font-bold'
                    : 'text-stone-500 hover:text-stone-900'
                }`}
              >
                {label}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="max-w-5xl mx-auto px-4 py-16">
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-semibold tracking-widest text-[#8B263E] uppercase bg-rose-50 px-3 py-1 rounded-full border border-rose-100">
          {t('hero.badge')}
        </span>
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-stone-900 mt-4 mb-6 leading-tight">
          {t('hero.title')}
        </h1>
        <p class="text-lg text-stone-600 leading-relaxed">
          {t('hero.subtitle')}
        </p>
      </div>

      <!-- Cards Grid -->
      <div id="spots" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {spots.map(spot => (
          <div class="bg-white rounded-2xl p-6 border border-stone-200/80 shadow-sm hover:shadow-md transition duration-200 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-4">
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-md ${spot.color}`}>
                  {spot.tag}
                </span>
                <span class="text-xs text-stone-400 font-medium">{spot.category}</span>
              </div>
              <h3 class="text-xl font-bold text-stone-900 mb-2">{spot.title}</h3>
              <p class="text-stone-600 text-sm leading-relaxed mb-6">{spot.description}</p>
            </div>
            <a href="#" class="inline-flex items-center text-sm font-semibold text-[#8B263E] hover:underline">
              {t('more')} &rarr;
            </a>
          </div>
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 bg-white mt-20 py-8 text-center text-xs text-stone-500">
      <p>© 2026 Tbilisi Guide.</p>
    </footer>

  </body>
</html>
