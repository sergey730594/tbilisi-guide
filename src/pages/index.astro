---
// Данные для карточек (в будущем их легко вынести в отдельные файлы)
const spots = [
  {
    title: "Кафе и спешелти-кофе",
    category: "Work & Vibe",
    description: "Лучшие локации с хорошим Wi-Fi, розетками и правильным флэт-уайтом для работы и встреч.",
    tag: "Digital Nomad",
    color: "bg-amber-100 text-amber-800"
  },
  {
    title: "Натуральные вина Qvevri",
    category: "Gastronomy",
    description: "Камерные винные бары в Сололаки и Вера, где подают оранжевое вино от микро-виноделен.",
    tag: "True Local",
    color: "bg-rose-100 text-rose-800"
  },
  {
    title: "Маршрутки & Логистика",
    category: "Smart Travel",
    description: "Пошаговый гид: как уехать в Казбеги, Сигнахи или Батуми без лишних переплат.",
    tag: "Must Read",
    color: "bg-emerald-100 text-emerald-800"
  }
];
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TBILISI GUIDE — Интерактивный гид по Тбилиси</title>
  </head>
  <body class="bg-[#FDFBF7] text-slate-800 font-sans antialiased">
    
    <!-- Header -->
    <header class="border-b border-stone-200 bg-white/80 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 py-4 flex justify-between items-center">
        <span class="font-extrabold text-xl tracking-tight text-[#8B263E]">TBILISI GUIDE</span>
        <nav class="space-x-6 text-sm font-medium text-stone-600 hidden sm:block">
          <a href="#spots" class="hover:text-stone-900 transition">Места</a>
          <a href="#logistics" class="hover:text-stone-900 transition">Маршруты</a>
          <a href="#nomad" class="hover:text-stone-900 transition">Кочевникам</a>
        </nav>
      </div>
    </header>

    <!-- Hero Section -->
    <main class="max-w-5xl mx-auto px-4 py-16">
      <div class="max-w-2xl mb-12">
        <span class="text-xs font-semibold tracking-widest text-[#8B263E] uppercase bg-rose-50 px-3 py-1 rounded-full border border-rose-100">Гид нового поколения</span>
        <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-stone-900 mt-4 mb-6 leading-tight">
          Открывай Тбилиси без туристических ловушек
        </h1>
        <p class="text-lg text-stone-600 leading-relaxed">
          Честные подборки заведений, секретные парадные, быстрый Wi-Fi для работы и понятная логистика по всей Грузии.
        </p>
      </div>

      <!-- Cards Grid -->
      <div id="spots" class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {spots.map(spot => (
          <div class="bg-white rounded-2xl p-6 border border-stone-200/80 shadow-sm hover:shadow-md transition duration-200 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-start mb-4">
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-md ${spot.color}`}>
                  {spot.tag}
                </span>
                <span class="text-xs text-stone-400 font-medium">{spot.category}</span>
              </div>
              <h3 class="text-xl font-bold text-stone-900 mb-2">{spot.title}</h3>
              <p class="text-stone-600 text-sm leading-relaxed mb-6">{spot.description}</p>
            </div>
            <a href="#" class="inline-flex items-center text-sm font-semibold text-[#8B263E] hover:underline">
              Смотреть подборку &rarr;
            </a>
          </div>
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-stone-200 bg-white mt-20 py-8 text-center text-xs text-stone-500">
      <p>© 2026 Tbilisi Guide. Сделано с любовью к Тбилиси.</p>
    </footer>

  </body>
</html>
